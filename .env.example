# Copy to .env and fill in. Never commit .env. Never paste keys in chat or docs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=ionforge
ZAVUDEV_API_KEY=
ZAVU_WEBHOOK_SECRET=
APPROVER_PHONE=+56900000000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MP_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENALEX_MAILTO=

# Model choices (override if a model is unavailable)
EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# Omnigent agent models (agents/build.py reads these defaults; override there)

# Model routing (agents/build.py, literature/extract_cards.py)
# The Critic (Claude) goes through OpenRouter: live demo uses OPENROUTER_API_KEY,
# overnight campaigns use OPENROUTER_API_KEY_CAMPAIGNS (set a credit limit on each key).
# Card extraction + voice briefings on Mistral so OpenRouter credits stay for the agents and the judges.
EXTRACTOR_ROUTE=mistral
OPENROUTER_API_KEY_CAMPAIGNS=

# Backup keys from the other team member: used automatically when the primary is
# rejected or out of credits (integrations/llm.py, scripts/openrouter_keys.py).
OPENROUTER_API_KEY_BACKUP=
MISTRAL_API_KEY_BACKUP=

# Lab engine (agents/build.py). Mistral runs the lab; the Critic is Claude on OpenRouter
# (a different family from the Mistral Hypothesis Generator).
MISTRAL_LARGE_MODEL=mistral-large-latest
MISTRAL_SMALL_MODEL=mistral-small-latest
CRITIC_MODEL=anthropic/claude-sonnet-5.5
# PI_ENGINE=claude moves only the PI to Claude Sonnet on OpenRouter.
PI_ENGINE=mistral
# Live demo / smoke tests use MISTRAL_API_KEY + OPENROUTER_API_KEY; overnight campaigns
# and ablations use the *_CAMPAIGNS keys, so a campaign can never spend the demo budget.
MISTRAL_API_KEY_CAMPAIGNS=

# Judge-triggered rounds (scripts/judge_runner.py). Off until the gate is passed.
JUDGE_RUNS=off
JUDGE_MAX_PER_HOUR=4
JUDGE_MAX_PER_DAY=12
JUDGE_BUDGET=50
