# Copy to .env and fill in. Never commit .env. Never paste keys in chat or docs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1
ZAVUDEV_API_KEY=
ZAVU_WEBHOOK_SECRET=
APPROVER_PHONE=+56900000000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MP_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENALEX_MAILTO=

# Model choices (override if a model is unavailable)
EXTRACTOR_MODEL=claude-haiku-4-5-20251001
CRITIC_MODEL=google/gemini-3.8-flash

# Omnigent agent models (agents/build.py reads these defaults; override there)
MISTRAL_SCOUT_MODEL=mistral-small-latest

# Model routing (agents/build.py, literature/extract_cards.py)
# Claude agents and the Critic go through OpenRouter: live demo uses OPENROUTER_API_KEY,
# overnight campaigns and ablations use OPENROUTER_API_KEY_CAMPAIGNS (set a credit limit on each key).
LLM_ROUTE=openrouter
EXTRACTOR_ROUTE=openrouter
OPENROUTER_API_KEY_CAMPAIGNS=
